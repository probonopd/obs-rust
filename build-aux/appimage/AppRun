#!/bin/sh
# AppRun for the OBS Studio (obs-rust) AppImage.
#
# The AppImage ships its own glibc, so every executable in it has its ELF
# interpreter patched to @LOADER@ (a fixed path chosen at build time; the
# kernel cannot expand variables there). This script makes sure a copy of the
# bundled dynamic loader exists at that path before starting OBS. Keeping the
# kernel in charge of the loader (instead of running `ld.so obs`) keeps
# /proc/self/exe pointing at the real binary, which OBS uses to find its data
# and plugins, and it makes helper processes (obs-ffmpeg-mux, ...) work too.
HERE="$(dirname "$(readlink -f "$0")")"
LOADER="@LOADER@"
LOADER_DIR="$(dirname "$LOADER")"
BUNDLED_LOADER="$HERE/lib64/ld-linux-x86-64.so.2"

# Only coreutils here: minimal containers lack cmp, find, ...
same_loader() {
    [ -f "$LOADER" ] && [ "$(sha256sum <"$BUNDLED_LOADER")" = "$(sha256sum <"$LOADER")" ]
}
if ! same_loader; then
    umask 022
    mkdir -p "$LOADER_DIR" 2>/dev/null
    tmp="$(mktemp "$LOADER_DIR/.ld.XXXXXX" 2>/dev/null)" &&
        cp "$BUNDLED_LOADER" "$tmp" && chmod 755 "$tmp" &&
        mv -f "$tmp" "$LOADER"
fi
# Never trust a loader directory someone else owns or can write to: it is
# executed as the interpreter of every process we start.
owner="$(stat -c %u "$LOADER_DIR" 2>/dev/null)"
mode="$(stat -c %a "$LOADER_DIR" 2>/dev/null)"
case "$mode" in
*[2367]? | *[2367]) writable=1 ;;
*) writable=0 ;;
esac
if ! same_loader || [ "$writable" = 1 ] || { [ "$owner" != "$(id -u)" ] && [ "$owner" != 0 ]; }; then
    echo "obs AppImage: cannot set up the bundled loader in $LOADER_DIR" >&2
    echo "(the directory must be writable by you only and /tmp must allow exec)" >&2
    exit 1
fi

export APPDIR="$HERE"
# Deliberately NO LD_LIBRARY_PATH: every bundled ELF carries a relative RPATH
# (set-runpaths.sh). An exported LD_LIBRARY_PATH would leak into every process
# OBS spawns, and host programs crash when they pick up the bundled glibc.
export QT_PLUGIN_PATH="$HERE/usr/lib/qt6/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="$HERE/usr/lib/qt6/plugins/platforms"
export GCONV_PATH="$HERE/usr/lib/gconv"
export XDG_DATA_DIRS="$HERE/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export SPA_PLUGIN_DIR="$HERE/usr/lib/spa-0.2"
export PIPEWIRE_MODULE_DIR="$HERE/usr/lib/pipewire-0.3"
export PIPEWIRE_CONFIG_DIR="$HERE/usr/share/pipewire"
# Host certificate bundles live in different places per distribution.
if [ -z "$SSL_CERT_FILE" ]; then
    for f in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt \
        /etc/ssl/ca-bundle.pem /etc/ssl/cert.pem; do
        [ -r "$f" ] && { export SSL_CERT_FILE="$f"; break; }
    done
fi
# Never let the host inject modules built against its own (different) Qt/GLib:
# usr/bin/qt.conf pins Qt's plugin search to the bundle, and GIO/GSettings
# modules (dconf, gvfs, ...) are loaded from an empty bundled directory only.
unset QT_QPA_PLATFORMTHEME QT_STYLE_OVERRIDE QT_IM_MODULE QT_QPA_PLATFORM_PLUGIN_PATH_HOST
export GIO_MODULE_DIR="$HERE/usr/lib/gio/modules"
export GIO_USE_VFS=local
export GSETTINGS_BACKEND=memory

if [ -n "$OBS_APPIMAGE_DEBUG" ]; then
    # Troubleshooting: OBS_APPIMAGE_DEBUG=1 ./OBS_Studio-*.AppImage
    # prints the environment and, when gdb is installed, a backtrace of a crash.
    echo "== AppImage environment ==" >&2
    env | sort | grep -E '^(APPDIR|LD_|QT_|GIO_|GSETTINGS_|XDG_|WAYLAND|DISPLAY|DBUS|LANG|LC_)' >&2
    export QT_DEBUG_PLUGINS=1 LIBGL_DEBUG=verbose EGL_LOG_LEVEL=debug
    if command -v gdb >/dev/null 2>&1; then
        exec gdb -q -batch -ex 'set pagination off' -ex 'handle SIGPIPE nostop noprint' -ex run \
            -ex 'echo \n== backtrace ==\n' -ex bt -ex 'thread apply all bt 30' \
            --args "$HERE/usr/bin/obs" "$@"
    fi
    echo "gdb not found; install it to get a backtrace" >&2
fi

exec "$HERE/usr/bin/obs" "$@"
